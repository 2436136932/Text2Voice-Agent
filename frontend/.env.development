# Development environment variables (consumed by Vite via import.meta.env)
# Base path of the backend API. The Vite dev server proxies /api -> http://localhost:8000
VITE_API_BASE_URL=/api/v1

# Public base path used by vue-router createWebHistory()
VITE_APP_BASE_URL=/

# Application title shown in the header / document title
VITE_APP_TITLE=Text2Voice Agent

# Swagger / OpenAPI docs opened from the header (new tab)
VITE_DOCS_URL=/docs

# Backend health poll interval in milliseconds
VITE_HEALTH_POLL_INTERVAL_MS=30000