# ===========================================================================
# Text2Voice Agent - environment template
#
#   cp .env.example backend/.env      # local development
#
# Every variable uses the T2V_ prefix. NO API KEY BELONGS IN THIS FILE:
# provider credentials are entered in the web UI and forwarded once per
# request - they are never read from the environment and never persisted.
# ===========================================================================

# -- application ------------------------------------------------------------
T2V_ENVIRONMENT=development
T2V_DEBUG=false
T2V_HOST=0.0.0.0
T2V_PORT=8000
T2V_LOG_LEVEL=INFO
# console | json
T2V_LOG_FORMAT=console

# -- storage ----------------------------------------------------------------
# Relative paths resolve against backend/
T2V_DATABASE_URL=sqlite+aiosqlite:///./data/text2voice.db
T2V_AUDIO_DIR=./data/audio
# 0 disables the automatic purge job
T2V_AUDIO_RETENTION_DAYS=30

# -- CORS (comma separated) -------------------------------------------------
T2V_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- input limits -----------------------------------------------------------
T2V_MAX_TEXT_LENGTH=5000
T2V_MAX_REQUEST_BYTES=2097152

# -- rate limiting (per client IP, in-process token bucket) -----------------
T2V_RATE_LIMIT_ENABLED=true
T2V_RATE_LIMIT_REQUESTS=30
T2V_RATE_LIMIT_WINDOW_SECONDS=60
# stricter bucket for endpoints that spend money upstream
T2V_RATE_LIMIT_GENERATE_REQUESTS=10
T2V_RATE_LIMIT_GENERATE_WINDOW_SECONDS=60

# -- upstream calls ---------------------------------------------------------
T2V_LLM_TIMEOUT_SECONDS=60
T2V_TTS_TIMEOUT_SECONDS=90
T2V_VALIDATE_TIMEOUT_SECONDS=20
T2V_UPSTREAM_MAX_RETRIES=2
T2V_UPSTREAM_BACKOFF_BASE_SECONDS=0.5
T2V_UPSTREAM_BACKOFF_MAX_SECONDS=4

# -- async task manager -----------------------------------------------------
T2V_TASK_WORKERS=4
T2V_TASK_QUEUE_SIZE=200
T2V_TASK_RETENTION_MINUTES=60

# -- degradation fallbacks --------------------------------------------------
# When true, a failed LLM/TTS call yields a placeholder result marked
# degraded=true instead of an error response.
T2V_FALLBACK_ENABLED=true
T2V_FALLBACK_TTS_ENABLED=true

# -- provider default endpoints --------------------------------------------
# Override to route through a gateway, proxy or Azure deployment.
T2V_OPENAI_BASE_URL=https://api.openai.com/v1
T2V_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
T2V_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
T2V_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
T2V_AZURE_SPEECH_BASE_URL=https://{region}.tts.speech.microsoft.com
T2V_VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v1/tts

# -- hardening --------------------------------------------------------------
# Set true to hide /docs, /redoc and /openapi.json in production.
T2V_DISABLE_DOCS=false
# Extra literal strings to redact from logs (comma separated).
T2V_REDACT_EXTRA_KEYS=